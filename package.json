{
  "name": "lucidio-ai-video-generator",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "node dist-server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:server": "tsx --test \"server/**/*.test.ts\"",
    "test:client": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "express": "latest",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.22.0",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.3",
    "typescript": "latest",
    "vite": "latest",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "tsx": "latest"
  }
}
